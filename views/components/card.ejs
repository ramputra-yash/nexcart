<div class="card_container w-[120px] h-[fit-content] bg-zinc-100/50 flex gap-2 flex-col rounded-lg" style="padding: 5px;">
    <a href="/product/<%= product._id %>">
        <img class="w-[110px] h-[110px] rounded-lg object-cover" src="/images/uploads/<%= product.product_image %>" alt="">
    </a>
    <div class="flex flex-col gap-2" style="padding: 0 5px;">
        <p class="text-xs truncate"><%= product.product_name %></p>
        <p class="text-[10px] text-zinc-500 truncate"><%= product.product_description %></p>
    </div>
    <div class="flex items-center gap-2 justify-between">
        <span class="text-sm font-bold text-green-500" style="margin-left: 5px;">₹<%= product.product_new_price %></span>
        <button class="add_to_cart_button_small bg-green-500 w-[35px] h-[35px] text-white font-bold flex items-center justify-center text-[10px] rounded-lg cursor-pointer" data-product-id="<%= product._id %>">
            <i class="ri-shopping-cart-line"></i>
        </button>
    </div>
</div>