<style>
    .login_btn:hover span{
        display: block;
    }
    .profileBox {
        position: fixed;
        top: -500px;
        transition: all 0.3s cubic-bezier(0.2, 0.5, 0.2, 1.3);
    }
    .profileBox.active {
        top: 100px;
    }
    nav {
        background: #dddddd77;
        backdrop-filter: blur(10px);
        position: relative;
         /* Transition effect for smoothness */
        transition: all 0.3s ease;
        opacity: 1;
    }
    nav.scrolled {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 5;
        background: #dddddd77;
        backdrop-filter: blur(10px);
        transition: all 0.3s cubic-bezier(0.2, 0.5, 0.2, 1.3);
        transform: translateY(0); /* Slide from top (change from -100% if you want slide-in) */
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.055);
    }
</style>
<nav class=" w-full relative top-0 left-0 z-[5] bg-[#dddddd77] flex justify-between items-center h-[80px]" style="padding: 0 30px;backdrop-filter: blur(10px);">
    <a href="/" class="flex items-center gap-1">
        <i class="ri-shopping-cart-2-fill text-green-500 text-2xl"></i>
        <span class="font-bold text-zinc-600">Nexcart</span>
    </a>
    <div class="flex items-center gap-2">
        <% if (!user) { %>
            <a href="/auth/google" class=" login_btn flex items-center bg-zinc-100/50 h-[45px] w-[100px] justify-center hover:bg-zinc-100/70 rounded-lg gap-2" style="padding: 5px 10px;transition: .4s;">
                <i class="ri-login-box-line"></i>
                <span>Login</span>
            </a>
        <% } else { %>
            <div class="flex items-center gap-2">
                <a href="/search" class="flex items-center justify-center bg-zinc-100/50 hover:shadow-lg rounded-lg gap-2 h-[45px] w-[45px]" style="transition: .4s;">
                    <i class="ri-search-line font-bold"></i>
                </a>
                <button type="button" class="profileBoxBtn cursor-pointer flex items-center justify-center bg-zinc-100/50 hover:shadow-lg rounded-lg gap-2 h-[45px] w-[45px]" style="transition: .4s;">
                    <i class="ri-user-line font-bold"></i> 
                </button>
                <a href="/cart" class="cart_count_button flex relative items-center justify-center bg-green-500 hover:shadow-lg rounded-lg gap-2 h-[45px] w-[45px]" style="transition: .4s;">
                    <i class="ri-shopping-cart-line font-bold text-white"></i>
                    <% if(cart.products.length > 0) { %>
                        <span class="absolute -top-2 -right-2 h-[25px] w-[25px] flex items-center justify-center bg-green-500 border-[3px] border-[#DDDDDD] text-white text-[10px] rounded-full font-bold"><%= cart.products.length %></span>
                    <% } else { %>
                        <span class="absolute -top-2 -right-2 h-[25px] w-[25px] flex items-center justify-center bg-green-500 border-[3px] border-[#DDDDDD] text-white text-[10px] rounded-full font-bold hidden"></span>
                    <% } %>
                </a>
            </div>
            <%- include('profilebox', { user }) %>
        <% } %>
    </div>
</nav>
<script>
   const profileBox = document.querySelector('.profileBox');
   const profileBoxBtn = document.querySelector('.profileBoxBtn');
   profileBoxBtn.addEventListener('click', (e) => {
       e.preventDefault();
       profileBox.classList.toggle('active');
   });

   function updateCartCount() {
       const cartCountElement = document.querySelector('.cart_count_button span');
       if (cartCountElement) {
           cartCountElement.textContent = cart.products.length;
       }
   }

   document.addEventListener('click', (e) => {
       if (!profileBoxBtn.contains(e.target) && !profileBox.contains(e.target)) {
           profileBox.classList.remove('active');
       }
   });

   window.addEventListener('scroll', () => {
       const navbar = document.querySelector('nav');
       if (window.scrollY > 100) {
           navbar.classList.add('scrolled');
           document.querySelector('body').style.paddingTop = '80px';
       } else {
           navbar.classList.remove('scrolled');
           document.querySelector('body').style.paddingTop = '0px';
       }
   });

</script>