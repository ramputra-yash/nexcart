<a href="/product/<%= product._id %>" class="product_card w-[300px] h-[auto] bg-zinc-100/50" style="padding: 10px; border-radius: 10px;">
    <img class="h-[300px] object-cover" style="border-radius: 5px;width: 100%;" src="<%= product.product_image %>" alt="">
    <div class="flex flex-col gap-2" style="padding: 10px;">
        <h1 class="text-xl font-bold w-full truncate"><%= product.product_name %></h1>
        <p class="text-sm text-zinc-500 w-full truncate"><%= product.product_description %></p>
        <div class="flex justify-between items-center">
            <div class="flex flex-col">
                <p class="old_price line-through text-sm text-zinc-500">₹<%= product.product_old_price %></p>
                <p class="new_price text-green-500 font-bold text-xl">₹<%= product.product_new_price %></p>
            </div>
        </div>
    </div>
</a>