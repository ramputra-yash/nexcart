<style>
    @import url('https://fonts.googleapis.com/css2?family=Boldonse&family=Comfortaa:wght@300..700&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap');
    .banner_img {
        -webkit-mask-image: linear-gradient(to bottom, black 70%, transparent 100%);
        mask-image: linear-gradient(to bottom, black 70%, transparent 100%);
    }
    .banner_font {
        font-family: "Boldonse", sans-serif;
        background: linear-gradient(to top right, #fff, #DDD);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .banner_p {
        font-family: "Boldonse", sans-serif;
        font-size: 1.2vw;
        margin-top: 10px;
        color: #fff;
    }

    .banner_container {
        margin-top: 50px;
        padding: 0 80px;
        height: 450px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(#00C951, transparent);
    }

    .shop_now_btn {
        width: 146px;
        position: relative; 
        height: 45px;
        overflow: hidden;
        background: linear-gradient(to right, #00c95069, #00C951);
        transition: .5s;
    }
    .shop_now_btn .ri-arrow-right-line {
        position: absolute;
        transition: .4s;
        right: 20px;
        opacity: 0;
        visibility: hidden;
    }

    .shop_now_btn:hover .ri-arrow-right-line {
        opacity: 1;
        right: 15px;
        visibility: visible;
    }
    .shop_now_btn:hover  {
        width: 170px;
        height: 45px;
    }
    .products_container {
        display: flex;
        flex-wrap: wrap;
        gap: 40px;
        justify-content: center;
        align-items: center;
        margin-bottom: 50px;
    }

    @media (max-width: 1000px) {
        .banner_container {
           padding: 20px;
           margin-top: 0px;
           height: auto;
           flex-direction: column;
           gap: 20px;
        }
        .banner_container .banner_font {
            font-size: 10vw;
        }
        .banner_container .banner_p {
            font-size: 4vw;
        }
        .banner_img {
            width: 250px;
            margin-top: -40px;
        }
    }

</style>
<%- include('partials/header') %>
    <%- include('components/navbar', { user : user || null, cart : cart || null } ) %>
    <div class="banner_container w-full flex items-center justify-between h-[400px] bg-red-500">
        <div>
            <h1 class="banner_font text-[5vw] font-bold">
                Your One-Stop Shop <br>
                for Everything.
            </h1>
            <p class="banner_p">Shopping Made Simple, Fast & Fun</p>
            <br>
            <a href="/products/Clothes" class="shop_now_btn hover:shadow-lg block rounded-lg gap-2 w-[146px]" style="transition: .4s; padding: 10px 20px;">
                <i class="ri-shopping-cart-line font-bold text-white"></i>
                <span class="font-bold text-white">Shop Now</span>
                <i class="ri-arrow-right-line text-white font-bold"></i>
            </a>
        </div>
        <div>
            <img class="banner_img w-[360px]" src="../images/ghibli_photo.png" alt="">
        </div>
    </div>
    <div class="w-full h-[auto]" style="margin-top: 100px;">
        <h1 class="text-center text-3xl text-green-500" style="padding: 20px 0;font-family:'Boldonse', sans-serif;">Latest Products!</h1>
        <br>
        <div class="products_container w-full h-[auto]">
            <% products.reverse().forEach((product) => { %>
                <%- include('components/productcard', { product }) %>
            <% }) %>
        </div>
    </div>
<%- include('components/footer') %>
<%- include('partials/footer') %>
