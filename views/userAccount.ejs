<%- include('partials/header') %>
<style>
    @media (max-width: 768px) {
      .product_container {
          flex-direction: column;
      }
      .product_container img {
          width: 100%;
          height: 240px;
          object-fit: cover;
      }
      .product_details_container {
          flex-direction: column;
      }
      .product_details {
          width: 100%;
      }
      .product_description {
          width: 100%;
      }
    }
</style>
<%- include('components/navbar') %>

    <div class="w-full h-[auto] flex flex-col gap-4" style="padding: 20px;">
        <div class="w-full h-[auto] flex items-center gap-4 border-b-2 border-zinc-300" style="padding: 20px 0;">
            <div class="w-[100px] h-[100px] rounded-full object-cover">
                <img class="w-[100px] h-[100px] rounded-full object-cover" src="<%= user.profileImage %>" alt="">
            </div>
            <div class="w-[220px] h-[auto] flex flex-col gap-2">
                <h1 class="text-zinc-700 text-2xl font-bold w-[200px] truncate"><%= user.name %></h1>
                <p class="text-zinc-500 text-sm w-[200px] truncate"><%= user.email %></p>
                <a href="/auth/logout" class="text-red-500 text-sm">Logout</a>
            </div>
        </div>
        <div class="w-full h-[auto] flex flex-col gap-4">
            <h1 class="text-zinc-700 text-2xl font-bold" style="padding:0 15px;">My Orders</h1>
            <% payments.forEach((payment) => { %>
                <div class="relative w-full h-[auto] flex flex-col rounded-lg gap-2 bg-zinc-100/50" style="padding: 10px;">
                    <div class="w-full h-[auto] flex items-center gap-2">
                        <% payment.products.forEach((product) => { %>
                            <img class="w-[50px] bg-white h-[50px] rounded-md object-cover" src="/images/uploads/<%= product.product.product_image %>" alt="">
                        <% }) %>
                    </div>
                    <div class="w-full h-[auto] flex gap-3 flex-wrap">
                        <div class="flex flex-col gap-2">
                            <h1>Order Id :  <span class="text-zinc-500 text-sm"><%= payment.orderId %></span> </h1>
                        </div>
                        <div class="flex flex-col gap-2">
                            <h1>Order Amount :  <span class="text-green-500 text-sm"><%= payment.orderAmount %></span> </h1>
                        </div>
                        <div class="flex flex-col gap-2">
                            <h1>Currency :  <span class="text-zinc-500 text-sm"><%= payment.currency %></span> </h1>
                        </div>
                        <div class="flex flex-col gap-2">
                            <h1>Customer Id :  <span class="text-zinc-500 text-sm"><%= payment.customerId %></span> </h1>
                        </div>
                        <div class="flex flex-col gap-2">
                            <h1>Customer Name :  <span class="text-zinc-500 text-sm"><%= payment.customerName %></span> </h1>
                        </div>
                        <div class="flex flex-col gap-2">
                            <h1>Customer Email :  <span class="text-zinc-500 text-sm"><%= payment.customerEmail %></span> </h1>
                        </div>
                        <div class="flex flex-col gap-2">
                            <h1>Customer Phone :  <span class="text-zinc-500 text-sm"><%= payment.customerPhone %></span> </h1>
                        </div>
                        <div class="flex flex-col gap-2">
                            <h1>Order Date :  <span class="text-zinc-500 text-sm"><%= payment.createdAt %></span> </h1>
                        </div>
                    </div>
                    <% if(payment.status == 'PAID') { %>
                        <span class="absolute right-2 bottom-2 bg-green-500 text-white rounded-md text-sm" style="padding: 5px 10px;"><%= payment.status %></span>
                    <% } else { %>
                        <span class="absolute right-2 bottom-2 bg-red-500 text-white rounded-md text-sm" style="padding: 5px 10px;"><%= payment.status %></span>
                    <% } %>
                </div>
            <% }) %>
        </div>
    </div>

<%- include('components/footer') %>
<%- include('partials/footer') %>